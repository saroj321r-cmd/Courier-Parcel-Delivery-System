<aside class="dashboard-sidebar">
    <div>
        <div class="sidebar-user-info">
            <div class="user-avatar-initials">
                <%= currentUser.name.charAt(0).toUpperCase() %>
            </div>
            <div>
                <div class="user-display-name"><%= currentUser.name %></div>
                <div class="user-display-role"><%= currentUser.role %></div>
            </div>
        </div>

        <nav class="sidebar-nav">
            <% if (currentUser.role === 'CUSTOMER') { %>
                <a href="/customer/dashboard" class="sidebar-link <%= locals.currentPath === '/customer/dashboard' ? 'active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                    <span>Dashboard</span>
                </a>
                <a href="/customer/parcels/book" class="sidebar-link <%= locals.currentPath === '/customer/parcels/book' ? 'active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                    <span>Book Parcel</span>
                </a>
                <a href="/customer/parcels" class="sidebar-link <%= locals.currentPath === '/customer/parcels' ? 'active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
                    <span>My Parcels</span>
                </a>
                <a href="/track" class="sidebar-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <span>Track Parcel</span>
                </a>

            <% } else if (currentUser.role === 'AGENT') { %>
                <a href="/agent/dashboard" class="sidebar-link <%= locals.currentPath === '/agent/dashboard' ? 'active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                    <span>Dashboard</span>
                </a>
                <a href="/agent/parcels" class="sidebar-link <%= locals.currentPath.startsWith('/agent/parcels') ? 'active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                    <span>Assigned Parcels</span>
                </a>
                <a href="/track" class="sidebar-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <span>Track Parcel</span>
                </a>

            <% } else if (currentUser.role === 'ADMIN') { %>
                <a href="/admin/dashboard" class="sidebar-link <%= locals.currentPath === '/admin/dashboard' ? 'active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                    <span>Dashboard</span>
                </a>
                <a href="/admin/parcels" class="sidebar-link <%= locals.currentPath.startsWith('/admin/parcels') ? 'active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
                    <span>All Parcels</span>
                </a>
                <a href="/admin/agents" class="sidebar-link <%= locals.currentPath.startsWith('/admin/agents') ? 'active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    <span>Delivery Agents</span>
                </a>
                <a href="/admin/zones" class="sidebar-link <%= locals.currentPath.startsWith('/admin/zones') ? 'active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line></svg>
                    <span>Delivery Zones</span>
                </a>
                <a href="/track" class="sidebar-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <span>Track Parcel</span>
                </a>
            <% } %>
        </nav>
    </div>

    <div class="sidebar-footer">
        <a href="/logout" class="sidebar-link" style="color: #EF4444;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            <span>Sign Out</span>
        </a>
    </div>
</aside>
