<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    <%- include('../partials/alerts') %>

    <div class="dashboard-layout">
        <%- include('../partials/sidebar') %>

        <main class="dashboard-main">
            <div class="page-header">
                <div>
                    <h1 class="page-title">Agent Delivery Dashboard</h1>
                    <p class="page-description">Welcome back, <%= currentUser.name %>! Your assigned route deliveries.</p>
                </div>
                <div>
                    <a href="/agent/parcels" class="btn btn-primary">View All Assigned Parcels</a>
                </div>
            </div>

            <!-- Statistics Grid -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-header">
                        <span class="stat-title">Total Assigned</span>
                        <div class="stat-icon">📋</div>
                    </div>
                    <div class="stat-value"><%= stats.total %></div>
                </div>

                <div class="stat-card">
                    <div class="stat-header">
                        <span class="stat-title">Picked Up</span>
                        <div class="stat-icon">📦</div>
                    </div>
                    <div class="stat-value"><%= stats.pickedUp %></div>
                </div>

                <div class="stat-card">
                    <div class="stat-header">
                        <span class="stat-title">In Transit</span>
                        <div class="stat-icon">🚚</div>
                    </div>
                    <div class="stat-value"><%= stats.inTransit %></div>
                </div>

                <div class="stat-card">
                    <div class="stat-header">
                        <span class="stat-title">Out for Delivery</span>
                        <div class="stat-icon">🛵</div>
                    </div>
                    <div class="stat-value" style="color: #8B5CF6;"><%= stats.outForDelivery %></div>
                </div>

                <div class="stat-card">
                    <div class="stat-header">
                        <span class="stat-title">Delivered</span>
                        <div class="stat-icon">✅</div>
                    </div>
                    <div class="stat-value" style="color: #10B981;"><%= stats.delivered %></div>
                </div>

                <div class="stat-card">
                    <div class="stat-header">
                        <span class="stat-title">Failed / Issues</span>
                        <div class="stat-icon">⚠️</div>
                    </div>
                    <div class="stat-value" style="color: #EF4444;"><%= stats.failed %></div>
                </div>
            </div>

            <!-- Pending Parcels Queue -->
            <div class="table-card">
                <div class="table-header">
                    <div>
                        <h2 class="card-title" style="margin: 0;">Active Shipments Requiring Action</h2>
                        <p class="card-subtitle" style="margin: 0;">Parcels currently assigned to your route</p>
                    </div>
                </div>

                <% if (pendingParcels && pendingParcels.length > 0) { %>
                    <div class="table-responsive">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Tracking ID</th>
                                    <th>Customer</th>
                                    <th>Pickup Location</th>
                                    <th>Destination Address</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% pendingParcels.forEach(parcel => { %>
                                    <tr>
                                        <td>
                                            <a href="/agent/parcels/<%= parcel._id %>" class="tracking-code">
                                                <%= parcel.trackingId %>
                                            </a>
                                        </td>
                                        <td>
                                            <%= parcel.customerId ? parcel.customerId.name : parcel.senderName %><br>
                                            <small style="color: var(--text-muted);"><%= parcel.senderPhone %></small>
                                        </td>
                                        <td><%= parcel.pickupAddress %>, <%= parcel.pickupPincode %></td>
                                        <td><%= parcel.dropAddress %>, <%= parcel.dropPincode %></td>
                                        <td><%= parcel.parcelType %> (<%= parcel.weight %> kg)</td>
                                        <td>
                                            <span class="badge <%= statusDetails[parcel.status] ? statusDetails[parcel.status].badgeClass : '' %>">
                                                <%= statusDetails[parcel.status] ? statusDetails[parcel.status].label : parcel.status %>
                                            </span>
                                        </td>
                                        <td>
                                            <a href="/agent/parcels/<%= parcel._id %>" class="btn btn-primary btn-sm">
                                                Update Status
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div style="padding: 3rem; text-align: center; color: var(--text-muted);">
                        <div style="font-size: 3rem; margin-bottom: 0.75rem;">🎉</div>
                        <h3>All caught up!</h3>
                        <p>No pending shipments currently waiting for status progression.</p>
                    </div>
                <% } %>
            </div>
        </main>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
