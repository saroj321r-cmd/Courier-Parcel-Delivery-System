<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/auth.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="auth-wrapper" style="min-height: calc(100vh - 220px);">
        <div class="auth-card" style="text-align: center; max-width: 520px;">
            <div style="font-size: 5rem; font-weight: 900; color: var(--accent-primary); line-height: 1; margin-bottom: 1rem;">
                404
            </div>
            <h1 style="font-size: 1.75rem; font-weight: 800; margin-bottom: 0.75rem;">Page Not Found</h1>
            <p style="color: var(--text-secondary); margin-bottom: 2rem;">
                The destination endpoint <code><%= path %></code> could not be found or has been moved within the CourierX dispatch network.
            </p>
            <div style="display: flex; justify-content: center; gap: 1rem;">
                <a href="/" class="btn btn-primary">Return to Home</a>
                <a href="/track" class="btn btn-outline">Track Shipment</a>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
