<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    <%- include('../partials/alerts') %>

    <div class="dashboard-layout">
        <%- include('../partials/sidebar') %>

        <main class="dashboard-main">
            <div class="page-header">
                <div>
                    <h1 class="page-title">Delivery Fleet Agents</h1>
                    <p class="page-description">Manage active delivery personnel, vehicle assignments, and routing zones.</p>
                </div>
                <div>
                    <a href="/admin/agents/new" class="btn btn-primary">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        Add New Agent
                    </a>
                </div>
            </div>

            <div class="table-card">
                <div class="table-header">
                    <h2 class="card-title" style="margin: 0;">Registered Agents</h2>
                </div>

                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Agent Name</th>
                                <th>Contact Information</th>
                                <th>Assigned Zone</th>
                                <th>Vehicle Reg.</th>
                                <th>Assigned Load</th>
                                <th>Status</th>
                                <th>Joined</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (agents && agents.length > 0) { %>
                                <% agents.forEach(agent => { %>
                                    <tr>
                                        <td>
                                            <div style="display: flex; align-items: center; gap: 0.75rem;">
                                                <div class="user-avatar-initials" style="width: 34px; height: 34px; font-size: 0.9rem; margin: 0;">
                                                    <%= agent.name.charAt(0).toUpperCase() %>
                                                </div>
                                                <strong><%= agent.name %></strong>
                                            </div>
                                        </td>
                                        <td>
                                            <%= agent.email %><br>
                                            <small style="color: var(--text-muted);"><%= agent.phone %></small>
                                        </td>
                                        <td><%= agent.zone || 'Central Routing' %></td>
                                        <td>
                                            <code><%= agent.vehicleNumber || 'Unregistered' %></code>
                                        </td>
                                        <td>
                                            <span class="badge <%= agent.assignedCount > 0 ? 'badge-in-transit' : 'badge-booked' %>">
                                                <%= agent.assignedCount %> parcels
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge <%= agent.isActive ? 'badge-active' : 'badge-inactive' %>">
                                                <%= agent.isActive ? 'Active' : 'Inactive' %>
                                            </span>
                                        </td>
                                        <td><%= new Date(agent.createdAt).toLocaleDateString() %></td>
                                        <td>
                                            <form action="/admin/agents/<%= agent._id %>/toggle" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to <%= agent.isActive ? 'deactivate' : 'activate' %> <%= agent.name %>?');">
                                                <button type="submit" class="btn btn-outline btn-sm" style="<%= agent.isActive ? 'color: #EF4444;' : 'color: #10B981;' %>">
                                                    <%= agent.isActive ? 'Deactivate' : 'Activate' %>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 3rem;">
                                        No delivery agents registered yet.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
