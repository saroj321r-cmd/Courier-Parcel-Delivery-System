<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    <%- include('../partials/alerts') %>

    <div class="dashboard-layout">
        <%- include('../partials/sidebar') %>

        <main class="dashboard-main">
            <div class="page-header">
                <div>
                    <h1 class="page-title">Welcome back, <%= currentUser.name %>!</h1>
                    <p class="page-description">Overview of your bookings and live parcel delivery statuses.</p>
                </div>
                <div>
                    <a href="/customer/parcels/book" class="btn btn-primary">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        Book New Parcel
                    </a>
                </div>
            </div>

            <!-- Statistics Grid -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-header">
                        <span class="stat-title">Total Shipments</span>
                        <div class="stat-icon">📦</div>
                    </div>
                    <div class="stat-value"><%= stats.total %></div>
                </div>

                <div class="stat-card">
                    <div class="stat-header">
                        <span class="stat-title">Booked / Pending</span>
                        <div class="stat-icon">📝</div>
                    </div>
                    <div class="stat-value"><%= stats.booked %></div>
                </div>

                <div class="stat-card">
                    <div class="stat-header">
                        <span class="stat-title">In Transit</span>
                        <div class="stat-icon">🚚</div>
                    </div>
                    <div class="stat-value"><%= stats.inTransit %></div>
                </div>

                <div class="stat-card">
                    <div class="stat-header">
                        <span class="stat-title">Delivered</span>
                        <div class="stat-icon">✅</div>
                    </div>
                    <div class="stat-value" style="color: #10B981;"><%= stats.delivered %></div>
                </div>

                <div class="stat-card">
                    <div class="stat-header">
                        <span class="stat-title">Failed / Issues</span>
                        <div class="stat-icon">⚠️</div>
                    </div>
                    <div class="stat-value" style="color: #EF4444;"><%= stats.failed %></div>
                </div>
            </div>

            <!-- Recent Parcels Table -->
            <div class="table-card">
                <div class="table-header">
                    <h2 class="card-title" style="margin: 0;">Recent Parcels</h2>
                    <a href="/customer/parcels" class="btn btn-outline btn-sm">View All Parcels</a>
                </div>

                <% if (recentParcels && recentParcels.length > 0) { %>
                    <div class="table-responsive">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Tracking ID</th>
                                    <th>Receiver</th>
                                    <th>Destination</th>
                                    <th>Weight</th>
                                    <th>Estimated Charge</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% recentParcels.forEach(parcel => { %>
                                    <tr>
                                        <td>
                                            <a href="/customer/parcels/<%= parcel._id %>" class="tracking-code">
                                                <%= parcel.trackingId %>
                                            </a>
                                        </td>
                                        <td><strong><%= parcel.receiverName %></strong></td>
                                        <td><%= parcel.dropAddress %>, <%= parcel.dropPincode %></td>
                                        <td><%= parcel.weight %> kg</td>
                                        <td>₹<%= parcel.estimatedCharge %></td>
                                        <td>
                                            <span class="badge <%= statusDetails[parcel.status] ? statusDetails[parcel.status].badgeClass : '' %>">
                                                <%= statusDetails[parcel.status] ? statusDetails[parcel.status].label : parcel.status %>
                                            </span>
                                        </td>
                                        <td><%= new Date(parcel.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></td>
                                        <td>
                                            <a href="/customer/parcels/<%= parcel._id %>" class="btn btn-outline btn-sm">Details</a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div style="padding: 3rem; text-align: center; color: var(--text-muted);">
                        <div style="font-size: 3rem; margin-bottom: 0.75rem;">📦</div>
                        <h3>No parcels booked yet</h3>
                        <p style="margin-bottom: 1.5rem;">Create your first parcel delivery booking now.</p>
                        <a href="/customer/parcels/book" class="btn btn-primary">Book a Parcel</a>
                    </div>
                <% } %>
            </div>
        </main>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
